# Copy to .env and fill in. Never commit .env.

# Capital One Nessie — https://api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Google Gemini
GEMINI_API_KEY=

# Tiger Data (Postgres connection string)
DATABASE_URL=

# Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Backend CORS — comma-separated app origins allowed to call the API
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
